# Server-only deployment configuration. Inject real values through Secret Manager.
APP_ENV=production
# Only with Cloud Run IAM required and invoker limited to the Vercel caller.
CLIENT_IP_SOURCE=vercel
ALLOWED_ORIGINS=https://YOUR_FRONTEND_HOST
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PROJECT_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
CHAT_DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER:5432/postgres?sslmode=require
QUOTA_HASH_SECRET=GENERATE_AN_INDEPENDENT_SECRET_WITH_AT_LEAST_32_CHARACTERS
# Preserve the model/provider used by the existing Parquet; never regenerate during deployment.
EMBED_PROVIDER=studio
GEMINI_API_KEY=YOUR_EMBEDDING_API_KEY
# Explicit switch: enable only after checking the actual provider billing settings.
AGENT_LLM=off
VERTEX_API_KEY=YOUR_LLM_API_KEY_IF_ENABLED
LLM_MAX_OUTPUT_TOKENS=4096
