# Copy into the repository root .env; never put database credentials in frontend.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
CHAT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Production: set a stable independent random QUOTA_HASH_SECRET; local defaults to the DB DSN.
# Start: .venv\Scripts\python.exe -m uvicorn backend.api.main:app --env-file .env --host 127.0.0.1 --port 8000 --no-proxy-headers
