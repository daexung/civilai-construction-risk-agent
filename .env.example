# KMA API (기상청)
KMA_API_KEY=your_api_key_here
KMA_VILAGE_FCST_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0/getVilageFcst
KMA_ULTRA_SRT_NCST_URL=https://apihub.kma.go.kr/api/typ02/openApi/VilageFcstInfoService_2.0/getUltraSrtNcst

# PostgreSQL (담당자에게 확인)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=construction_risk_agent
DB_USER=postgres
DB_PASSWORD=your_password_here

# AWS Bedrock
AWS_BEDROCK_REGION=us-east-1
# Bedrock 인증 토큰(사용 환경에 따라 선택)
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here

# ── 모델 설정 ──────────────────────────────────────────────
# router/extractor/synthesize 노드는 bedrock_models.py를 통해 아래 전용 env를 읽고,
# 미설정 시 BEDROCK_MODEL_ID(공통 기본값)로 폴백한다.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0  # 공통 기본/폴백 모델
MODEL_ROUTER=        # 라우터 질문 분류(intent/domains). 미설정 시 BEDROCK_MODEL_ID
MODEL_EXTRACTOR=     # extractor 입력값 추출. 미설정 시 BEDROCK_MODEL_ID
MODEL_SYNTHESIZE=    # 최종 답변 합성. 미설정 시 BEDROCK_MODEL_ID

# 비용 에이전트(equipment·material·labor_cost)는 MODEL_ID를 직접 사용한다.
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
