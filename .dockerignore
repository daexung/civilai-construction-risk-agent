# Allow only API code and its serving data. Secrets, front-end, previews and dev tools never enter the context.
**
!Dockerfile
!.dockerignore
!deploy/
!deploy/backend-requirements.txt
!deploy/run_api.py
!deploy/calculation_sandbox/
!deploy/calculation_sandbox/**
!backend/
!backend/**
!pipeline/
!pipeline/requirements-rag.txt
!pipeline/calculation_contract.py
!pipeline/python_sandbox.py
!data/
!data/rates/
!data/rates/**
!data/calculation_modules/
!data/calculation_modules/approved/
!data/calculation_modules/approved/**
!data/drafts/
!data/drafts/executable.json
!data/drafts/misfiled.json
!data/drafts/specs/
!data/drafts/specs/**
!data/knowledge/
!data/knowledge/**
!data/processed/
!data/processed/chunks.all.jsonl
!data/processed/chunks.jsonl
!data/processed/page_map.json
!data/processed/embeddings.all.gemini-embedding-2.parquet
!data/raw/
!data/raw/standard_estimation/
!data/raw/standard_estimation/*.pdf
**/.env*
**/__pycache__
**/*.pyc
